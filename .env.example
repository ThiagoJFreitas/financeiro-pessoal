# Copie para .env e ajuste. Em produção, configure estas variáveis no painel do host.

# Gere uma chave nova para produção (ex.: python -c "import secrets;print(secrets.token_urlsafe(50))")
SECRET_KEY=troque-esta-chave-em-producao

# Local = True. Em produção = False.
DEBUG=True

# Hosts permitidos (separados por vírgula). Em produção inclua o domínio do host.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origem confiável p/ CSRF em produção (https). Ex.: https://meuapp.onrender.com
CSRF_TRUSTED_ORIGINS=

# Banco. Local usa SQLite por padrão (deixe vazio). Em produção, o host injeta:
# DATABASE_URL=postgres://user:pass@host:5432/dbname
DATABASE_URL=
